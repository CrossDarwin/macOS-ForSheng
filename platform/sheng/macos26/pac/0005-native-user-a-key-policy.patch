+ orr \lo, \lo, #SCTLR_PACIA_ENABLED
+ orr \lo, \lo, #SCTLR_PACDA_ENABLED
+ msr SCTLR_EL1, \lo
  isb
 .endmacro
 
@@ -136,6 +141,17 @@
