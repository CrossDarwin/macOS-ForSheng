+ ldr w2, [x2, TH_ARM_MACHINE_FLAGS]
+ mrs x3, SCTLR_EL1
+ orr x3, x3, #SCTLR_PACIA_ENABLED
+ orr x3, x3, #SCTLR_PACDA_ENABLED
+ tbz w2, #ARM_MACHINE_THREAD_DISABLE_USER_JOP_SHIFT, Lsheng_user_enables_ready_\@
+ bic x3, x3, #SCTLR_PACIA_ENABLED
+ bic x3, x3, #SCTLR_PACDA_ENABLED
+Lsheng_user_enables_ready_\@:
+ msr SCTLR_EL1, x3
  isb
  b Lsheng_user_keys_done_\@
 Lsheng_bad_user_key_\@:
