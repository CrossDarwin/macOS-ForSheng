--- a/osfmk/arm64/pac_asm.h
+++ b/osfmk/arm64/pac_asm.h
@@ -107,6 +107,11 @@
  ldr \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 64) + 8)]
  msr APGAKeyLo_EL1, \lo
  msr APGAKeyHi_EL1, \hi
+ /* EL0可按任务关闭A认证，任何内核认证之前必须恢复 */
