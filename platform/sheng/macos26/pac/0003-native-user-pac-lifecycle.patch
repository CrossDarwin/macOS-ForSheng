 /* BEGIN IGNORE CODESTYLE */
+
+#if HAS_NATIVE_EL1_PAC
+/* 四个不同域的PACGA结果组成128位密钥，GA始终最后切换 */
+.macro SHENG_DERIVE_USER_KEY seed, lo, hi, tag, part, domain
+ MOV32 \tag, (0x53480000 | (\domain << 8))
+ pacga \lo, \seed, \tag
+ lsr \lo, \lo, #32
+ MOV32 \tag, (0x53480001 | (\domain << 8))
+ pacga \part, \seed, \tag
+ orr \lo, \lo, \part
+ MOV32 \tag, (0x53480002 | (\domain << 8))
+ pacga \hi, \seed, \tag
+ lsr \hi, \hi, #32
+ MOV32 \tag, (0x53480003 | (\domain << 8))
+ pacga \part, \seed, \tag
+ orr \hi, \hi, \part
+.endmacro
+
+.macro SHENG_SAVE_KERNEL_KEYS cpu, lo, hi
+ mrs \lo, APIAKeyLo_EL1
+ mrs \hi, APIAKeyHi_EL1
+ str \lo, [\cpu, CPU_SHENG_PAC_BANK]
+ str \hi, [\cpu, (CPU_SHENG_PAC_BANK + 8)]
+ mrs \lo, APIBKeyLo_EL1
+ mrs \hi, APIBKeyHi_EL1
+ str \lo, [\cpu, (CPU_SHENG_PAC_BANK + 16)]
+ str \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 16) + 8)]
+ mrs \lo, APDAKeyLo_EL1
+ mrs \hi, APDAKeyHi_EL1
+ str \lo, [\cpu, (CPU_SHENG_PAC_BANK + 32)]
+ str \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 32) + 8)]
+ mrs \lo, APDBKeyLo_EL1
+ mrs \hi, APDBKeyHi_EL1
+ str \lo, [\cpu, (CPU_SHENG_PAC_BANK + 48)]
+ str \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 48) + 8)]
+ mrs \lo, APGAKeyLo_EL1
+ mrs \hi, APGAKeyHi_EL1
+ str \lo, [\cpu, (CPU_SHENG_PAC_BANK + 64)]
+ str \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 64) + 8)]
+.endmacro
+
+.macro SHENG_RESTORE_KERNEL_KEYS cpu, lo, hi
+ ldr \lo, [\cpu, CPU_SHENG_PAC_BANK]
+ ldr \hi, [\cpu, (CPU_SHENG_PAC_BANK + 8)]
+ msr APIAKeyLo_EL1, \lo
+ msr APIAKeyHi_EL1, \hi
+ ldr \lo, [\cpu, (CPU_SHENG_PAC_BANK + 16)]
+ ldr \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 16) + 8)]
+ msr APIBKeyLo_EL1, \lo
+ msr APIBKeyHi_EL1, \hi
+ ldr \lo, [\cpu, (CPU_SHENG_PAC_BANK + 32)]
+ ldr \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 32) + 8)]
+ msr APDAKeyLo_EL1, \lo
+ msr APDAKeyHi_EL1, \hi
+ ldr \lo, [\cpu, (CPU_SHENG_PAC_BANK + 48)]
+ ldr \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 48) + 8)]
+ msr APDBKeyLo_EL1, \lo
+ msr APDBKeyHi_EL1, \hi
+ ldr \lo, [\cpu, (CPU_SHENG_PAC_BANK + 64)]
+ ldr \hi, [\cpu, ((CPU_SHENG_PAC_BANK + 64) + 8)]
+ msr APGAKeyLo_EL1, \lo
+ msr APGAKeyHi_EL1, \hi
+ isb
+.endmacro
+
+/* 仅在GPR尚未恢复且内核GA密钥仍有效时使用，保留x0/x16/x17/LR */
+.macro SHENG_INSTALL_USER_KEYS
+ mrs x2, TPIDR_EL1
+ ldr x1, [x2, ACT_CPUDATAP]
+ SHENG_SAVE_KERNEL_KEYS x1, x3, x4
+ ldr x7, [x2, TH_ROP_PID]
+ ldr x2, [x2, TH_JOP_PID]
+ cbz x2, Lsheng_bad_user_key_\@
+ SHENG_DERIVE_USER_KEY x2, x3, x4, x5, x6, 1
+ msr APIAKeyLo_EL1, x3
+ msr APIAKeyHi_EL1, x4
+ SHENG_DERIVE_USER_KEY x2, x3, x4, x5, x6, 3
+ msr APDAKeyLo_EL1, x3
+ msr APDAKeyHi_EL1, x4
+ SHENG_DERIVE_USER_KEY x7, x3, x4, x5, x6, 2
+ msr APIBKeyLo_EL1, x3
+ msr APIBKeyHi_EL1, x4
+ SHENG_DERIVE_USER_KEY x7, x3, x4, x5, x6, 4
+ msr APDBKeyLo_EL1, x3
+ msr APDBKeyHi_EL1, x4
+ SHENG_DERIVE_USER_KEY x2, x3, x4, x5, x6, 5
+ ldr x5, [x1, CPU_SHENG_PAC_RETURNS]
+ add x5, x5, #1
+ str x5, [x1, CPU_SHENG_PAC_RETURNS]
+ msr APGAKeyLo_EL1, x3
+ msr APGAKeyHi_EL1, x4
+ isb
+ b Lsheng_user_keys_done_\@
+Lsheng_bad_user_key_\@:
+ brk #0x5348
+Lsheng_user_keys_done_\@:
+.endmacro
+#endif /* HAS_NATIVE_EL1_PAC */
