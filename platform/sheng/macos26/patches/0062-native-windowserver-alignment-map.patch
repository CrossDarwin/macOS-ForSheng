 #if SHENG && defined(MACH_BSD)
 #include <arm/thread.h>
+#include <libkern/copyio.h>
+#include <mach/arm/exception.h>
+#include <vm/vm_shared_region_xnu.h>
+
+static uint64_t
+sheng_windowserver_translation(uint64_t address, uint64_t *sctlr)
+{
+	uint64_t daif, saved_par, control, result;
+	/* Keep the query and PAR read on one CPU; restore the interrupted register state. */
+	__asm__ volatile(
+	    "mrs %0, daif\n"
+	    "msr daifset, #7\n"
+	    "mrs %1, par_el1\n"
+	    "mrs %2, sctlr_el1\n"
+	    "at s1e0w, %4\n"
+	    "isb\n"
+	    "mrs %3, par_el1\n"
+	    "msr par_el1, %1\n"
+	    "msr daif, %0\n"
+	    : "=&r"(daif), "=&r"(saved_par), "=&r"(control), "=&r"(result)
+	    : "r"(address) : "memory");
+	*sctlr = control;
+	return result;
+}
 
