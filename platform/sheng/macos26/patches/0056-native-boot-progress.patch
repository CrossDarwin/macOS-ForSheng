+#if SHENG
+#include <kern/clock.h>
+#include <kern/thread.h>
+uint64_t sheng_boot_progress_seconds(void)
+{
+	uint64_t uptime, nanoseconds;
+	clock_get_uptime(&uptime);
+	absolutetime_to_nanoseconds(uptime, &nanoseconds);
+	return nanoseconds / 1000000000ULL;
+}
+static void sheng_boot_progress_thread(__unused void *argument, __unused wait_result_t result)
+{
+	for (;;) {
+		sheng_boot_progress_tick();
+		assert_wait_timeout((event_t)&sheng_boot_progress_enabled, THREAD_UNINT, 2, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+void sheng_boot_progress_start(void)
+{
+	static uint32_t started;
+	uint32_t expected = 0;
+	if (!sheng_boot_progress_enabled || !__atomic_compare_exchange_n(&started, &expected, 1,
+	    0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return;
+	thread_t thread;
+	if (kernel_thread_start(sheng_boot_progress_thread, NULL, &thread) == KERN_SUCCESS)
+		thread_deallocate(thread);
+	else printf("SHENG-PROGRESS: timer thread unavailable\n");
+}
+#endif
+
