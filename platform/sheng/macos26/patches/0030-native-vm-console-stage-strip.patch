+static void
+sheng_vm_trace_remap(void)
+{
+	sheng_vm_trace(10);
+	const uintptr_t first = sheng_bootstrap_vm_row_pa;
+	if (first) {
+		const uintptr_t offset = first & 16383;
+		const vm_size_t bytes = (offset + 11 * sheng_bootstrap_vm_stride + 1460 + 16383) & ~(vm_size_t)16383;
+		if (bytes <= 1048576) {
+			const vm_offset_t mapped = ml_io_map(first - offset, bytes);
+			if (mapped) {
+				sheng_bootstrap_vm_pixels = mapped + offset;
+			}
+		}
+	}
+	sheng_vm_trace(11);
+}
+#define SHENG_VM_TRACE(stage) sheng_vm_trace(stage)
+#define SHENG_VM_REMAP() sheng_vm_trace_remap()
 #define SHENG_C_TRACE(stage) sheng_bootstrap_c_trace(args, stage)
 #else
 #define SHENG_C_TRACE(stage) ((void)0)
+#define SHENG_VM_TRACE(stage) ((void)0)
+#define SHENG_VM_REMAP() ((void)0)
 #endif
 
