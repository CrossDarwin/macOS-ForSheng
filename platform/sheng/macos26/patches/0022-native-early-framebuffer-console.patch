--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -560,12 +560,28 @@
 	 * Do this before the VRAM is trashed.
 	 */
 	check_for_panic_log();
+#if SHENG
+	bool early_console = false;
+	if (PE_parse_boot_argn("-sheng-early-console", &early_console, sizeof(early_console)) &&
+	    PE_state.video.v_baseAddr && PE_state.video.v_width && PE_state.video.v_height) {
+		PE_state.video.v_display = 0;
+	} else {
+		early_console = false;
+	}
+#endif
 
 	if (PE_state.video.v_display) {
 		PE_initialize_console(&PE_state.video, kPEGraphicsMode);
 	} else {
 		PE_initialize_console(&PE_state.video, kPETextMode);
 	}
+#if SHENG
+	if (early_console) {
+		/* Use the validated boot GOP until a real display driver takes ownership. */
+		PE_initialize_console(NULL, kPEAcquireScreen);
+		printf("SHENG: early framebuffer console acquired\n");
+	}
+#endif
 }
 
 int
