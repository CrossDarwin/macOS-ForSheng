   strlcpy (label, name, sizeof (label));
   absolute = absoluteOffset;
   bytes = size;
+#if defined(NATIVE_UFS_RECOVERY_ROOT) && NATIVE_UFS_RECOVERY_ROOT
+  // Publish the BaseSystem disk image stored in the partition rather than the underlying UFS controller.
