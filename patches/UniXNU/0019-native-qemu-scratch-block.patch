+IOReturn NativeVirtioBlock::submitScratchRequest(uint32_t operation, uint64_t sector, uint32_t bytes)
+{
+  if (!online || !scratchWritable) return kIOReturnNotWritable;
+  if ((operation == 1 && (!bytes || bytes > transferSize || (bytes & 511) ||
+       sector >= capacity || bytes / 512 > capacity - sector)) ||
+      (operation == 4 && (sector || bytes)) || (operation != 1 && operation != 4))
+    return kIOReturnBadArgument;
+  auto *queue = static_cast<unsigned char *>(queueMemory->getBytesNoCopy());
+  auto *descriptors = reinterpret_cast<Descriptor *>(queue);
+  auto *request = reinterpret_cast<Request *>(queue + 512);
+  volatile uint8_t *status = queue + 528;
+  *request = {operation, 0, sector};
+  *status = 0xff;
+  descriptors[0] = {queuePhysical + 512, sizeof(Request), 1, static_cast<uint16_t>(bytes ? 1 : 2)};
+  descriptors[1] = {transferPhysical, bytes, 1, 2};
+  descriptors[2] = {queuePhysical + 528, 1, 2, 0};
+  auto *available = reinterpret_cast<volatile uint16_t *>(queue + 128);
+  available[2 + availableIndex % queueSize] = 0;
+  dmaBarrier();
+  available[1] = ++availableIndex;
+  dmaBarrier();
+  write32(0x50, 0);
+  auto *used = reinterpret_cast<volatile uint16_t *>(queue + 256);
+  uint64_t deadline;
+  clock_interval_to_deadline(1000, kMillisecondScale, &deadline);
+  while (used[1] == usedIndex) {
+    if (mach_absolute_time() >= deadline) {
+      reset();
+      __atomic_fetch_add(&native_virtio_write_failures, 1, __ATOMIC_RELAXED);
+      return kIOReturnTimeout;
+    }
+    dmaBarrier();
+    IODelay(1);
+  }
+  dmaBarrier();
+  auto *element = reinterpret_cast<volatile Used *>(queue + 260) + usedIndex % queueSize;
+  bool valid = used[1] == static_cast<uint16_t>(usedIndex + 1) && element->id == 0 &&
+               element->length == 1 && *status == 0;
+  ++usedIndex;
+  uint32_t interrupts = read32(0x60) & 3;
+  if (interrupts) write32(0x64, interrupts);
+  if (!valid) {
+    reset();
+    __atomic_fetch_add(&native_virtio_write_failures, 1, __ATOMIC_RELAXED);
+    return kIOReturnIOError;
+  }
+  __atomic_fetch_add(operation == 4 ? &native_virtio_flush_requests : &native_virtio_write_requests,
+                     1, __ATOMIC_RELAXED);
+  return kIOReturnSuccess;
+}
