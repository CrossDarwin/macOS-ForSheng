+def build_switches(defines, overrides):
+    result = dict(defines)
+    for item in overrides or []:
+        key, separator, value = item.partition('=')
+        if (not separator or not re.fullmatch(r'[A-Z][A-Z0-9_]*', key)
+                or not re.fullmatch(r'[A-Za-z0-9_.+-]+', value)):
+            raise Error(f'invalid firmware build switch: {item!r}')
+        if key.startswith('FD_'):
+            raise Error('firmware FD geometry must come from the board configuration')
+        result[key] = value
+    return result
+
