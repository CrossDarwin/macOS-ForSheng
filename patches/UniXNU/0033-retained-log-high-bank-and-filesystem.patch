+STATIC VOID
+NativeLogWriteStatus (CONST CHAR16 *Name, CONST CHAR8 Magic[8], EFI_STATUS Result)
+{
+  EFI_FILE_PROTOCOL *Root;
+  EFI_STATUS Status;
+  UINT8 Record[16];
+  UINT64 Value;
+
+  Status = NativeLogOpenVolume (&Root);
+  if (EFI_ERROR (Status)) { return; }
+  Value = (UINT64)Result;
+  CopyMem (Record, Magic, 8);
+  CopyMem (Record + 8, &Value, sizeof (Value));
+  Status = NativeLogWriteFile (Root, (CHAR16 *)Name, Record, sizeof (Record));
+  if (!EFI_ERROR (Status)) { Status = Root->Flush (Root); }
+  Root->Close (Root);
+  if (EFI_ERROR (Status)) { Print (L"MACOSLOG: status record failed: %r\n", Status); }
+}
+
+STATIC EFI_STATUS
+NativeLogSave (VOID)
+{
+  EFI_STATUS Status;
+
+  Status = NativeLogRecover ();
+  NativeLogWriteStatus (L"RECOVERY.BIN", "SHNREC01", Status);
+  return Status;
+}
